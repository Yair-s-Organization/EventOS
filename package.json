{
  "name": "eventos",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun run --filter @eventos/backend dev",
    "dev:frontend": "bun run --filter @eventos/frontend dev",
    "build": "bun run --filter '*' build",
    "db:migrate": "bun run --filter @eventos/backend migration:run",
    "db:revert": "bun run --filter @eventos/backend migration:revert",
    "db:init": "bun run --filter @eventos/backend db:init",
    "db:seed": "bun run --filter @eventos/backend seed",
    "db:reset": "bun run --filter @eventos/backend db:reset",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:e2e": "HEADLESS=true bun run e2e/runAllSuites.ts",
    "test:e2e:headed": "HEADLESS=false bun run e2e/runAllSuites.ts",
    "test:e2e:auth": "bun run e2e/tests/auth.e2e.spec.ts",
    "test:e2e:register": "bun run e2e/tests/registerAcceptance.e2e.spec.ts",
    "test:e2e:email-verification": "bun run e2e/tests/emailVerification.e2e.spec.ts",
    "test:e2e:register-login": "bun run e2e/tests/registerAndLogin.e2e.spec.ts",
    "test:e2e:password-reset": "bun run e2e/tests/passwordReset.e2e.spec.ts",
    "test:e2e:account-verification": "bun run e2e/tests/accountVerification.e2e.spec.ts",
    "test:e2e:ticket-reservation": "bun run e2e/tests/ticketReservation.e2e.spec.ts",
    "test:e2e:tickets-module": "bun run e2e/tests/ticketsModule.e2e.spec.ts",
    "test:e2e:organizer-events": "bun run e2e/tests/organizerEvents.e2e.spec.ts",
    "test:e2e:subdireccion-login": "bun run e2e/tests/subdireccionLogin.e2e.spec.ts",
    "test:e2e:subdireccion-solicitud": "bun run e2e/tests/subdireccionSolicitudEvento.e2e.spec.ts",
    "test:e2e:event-lifecycle": "bun run e2e/tests/eventLifecycle.e2e.spec.ts",
    "test:e2e:logistics": "bun run e2e/tests/logisticsAccessControl.e2e.spec.ts",
    "test:e2e:admin-bitacora": "bun run e2e/tests/adminBitacora.e2e.spec.ts",
    "test:e2e:admin-espacios": "bun run e2e/tests/adminEspaciosEquipos.e2e.spec.ts",
    "test:e2e:admin-jefes": "bun run e2e/tests/adminJefeDepartamento.e2e.spec.ts",
    "test:e2e:admin-usuarios": "bun run e2e/tests/adminGestionUsuarios.e2e.spec.ts",
    "test:e2e:admin-perfil": "bun run e2e/tests/adminPerfil.e2e.spec.ts",
    "test:e2e:security": "bun run e2e/tests/securityResilience.e2e.spec.ts",
    "test:e2e:full-workflow": "bun run e2e/tests/fullAdversarialWorkflow.e2e.spec.ts"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/selenium-webdriver": "^4.35.7",
    "selenium-webdriver": "^4.52.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2"
  }
}